#!/bin/sh
# Enforces "type(scope): message", e.g. "feat(mullvad): add appearance tab".
# Enable once per clone: git config core.hooksPath .githooks
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-z0-9._-]+\)!?: .+'
head -n1 "$1" | grep -qE "$re|^(Merge|Revert) " && exit 0
echo "Commit message must look like: feat(plugin): message" >&2
echo "types: feat fix docs style refactor perf test build ci chore revert" >&2
exit 1
